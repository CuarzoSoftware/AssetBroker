#ifndef CZ_ASSETBROKERVERSION_H
#define CZ_ASSETBROKERVERSION_H

#define CZ_ASSET_BROKER_VERSION_MAJOR @VERSION_MAJOR@
#define CZ_ASSET_BROKER_VERSION_MINOR @VERSION_MINOR@
#define CZ_ASSET_BROKER_VERSION_PATCH @VERSION_PATCH@

// Pack into a 64-bit version integer (Major:32 | Minor:16 | Patch:16)
#define CZ_ASSET_BROKER_VERSION \
    ((static_cast<uint64_t>(CZ_ASSET_BROKER_VERSION_MAJOR) << 32) | \
     (static_cast<uint64_t>(CZ_ASSET_BROKER_VERSION_MINOR) << 16) | \
     (static_cast<uint64_t>(CZ_ASSET_BROKER_VERSION_PATCH)))

#endif // CZ_ASSETBROKERVERSION_H
